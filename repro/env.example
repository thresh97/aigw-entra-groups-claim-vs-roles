# Copy to repro/env (gitignored) and fill in. Everything environment-specific lives here; the scripts never need editing.
# Credentials: point at files or CLI profiles; don't paste secrets here.

# Required
TENANT_ID=                  # Entra tenant ID (GUID) or verified domain
PUBLIC_CLIENT_ID=           # client app with "Allow public client flows" enabled
API_APP_ID_URI=             # the API app registration's Application ID URI, e.g. api://<app-id>
TEST_USER_UPN=              # lab user: member of the groups under test, no MFA or Conditional Access
TEST_USER_PASSWORD_FILE=    # path to a file holding only that user's password
EXPECT_GROUP_COUNT=         # groups the user belongs to that should appear in the groups claim
EXPECT_ROLE_COUNT=          # app roles assigned to the user (directly or through groups)

# Required for the membership scenario only (also needs `az` logged in to the same tenant)
EXPECT_MEMBER_GROUP_COUNT=  # groups the user is a member of, including nested ones; more than EXPECT_GROUP_COUNT when the claim is limited to ApplicationGroup
